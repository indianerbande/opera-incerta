{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "opera-incerta-workbench": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "wi",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../build/workbench",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "*.svg",
                "input": "src/assets/material-symbols",
                "output": "icons"
              },
              {
                "glob": "{LICENSE,SOURCE.md}",
                "input": "src/assets/material-symbols",
                "output": "third-party/material-symbols"
              },
              {
                "glob": "*.woff2",
                "input": "src/assets/ibm-plex",
                "output": "fonts/ibm-plex"
              },
              {
                "glob": "{LICENSE,SOURCE.md}",
                "input": "src/assets/ibm-plex",
                "output": "third-party/ibm-plex"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "opera-incerta-workbench:build:production"
            },
            "development": {
              "buildTarget": "opera-incerta-workbench:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
