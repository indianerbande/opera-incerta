{
  "name": "@opera-incerta/desktop-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned contract between the Electron main process and the sandboxed renderer.",
  "license": "Apache-2.0",
  "exports": {
