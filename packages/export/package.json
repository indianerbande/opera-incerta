{
  "name": "@opera-incerta/export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Export formats as a module. Assembles the library into one document and renders it; portable: no DOM, no Electron, no Node.js APIs.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@opera-incerta/core": "workspace:*",
    "@opera-incerta/markdown": "workspace:*",
    "markdown-it": "15.0.1"
  }
}
